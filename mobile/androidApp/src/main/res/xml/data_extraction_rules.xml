<?xml version="1.0" encoding="utf-8"?>
<!--
  Nada do app vai para backup na nuvem nem para transferência entre aparelhos:
  o refresh fica cifrado com chave do Keystore, que não sai do aparelho, e a sessão
  deve ser criada de novo com login no aparelho novo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
