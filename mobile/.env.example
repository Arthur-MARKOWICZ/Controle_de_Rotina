# Configuração da URL da API no app mobile (ADR-0002).
# Copie para `mobile/.env` (ignorado pelo Git). O Gradle lê no build e grava em BuildConfig.API_BASE_URL.

# Ambiente usado pelo build: local | prod
API_ENV=local

# API local. `10.0.2.2` é como o emulador Android alcança o host (backend Spring na 8080).
# Em aparelho físico use o IP da máquina (ex.: http://192.168.0.10:8080) e acrescente esse host
# em androidApp/src/debug/res/xml/network_security_config.xml: HTTP só é liberado para os hosts
# listados lá, e somente no build debug.
API_BASE_URL_LOCAL=http://10.0.2.2:8080

# API publicada: só a origem HTTPS, sem porta, caminho, query ou barra final.
# O Nginx serve web e API no mesmo domínio (docs/deploy/https-producao.md).
API_BASE_URL_PROD=https://rotina.exemplo.com
