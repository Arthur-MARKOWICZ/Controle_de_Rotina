# Copie para .env e ajuste os valores.
# cp .env.example .env

# Perfil Spring. "local" usa cookie de refresh sem Secure (HTTP em dev).
# Qualquer outro perfil exige APP_SECURITY_JWT_SECRET e cookie Secure.
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (serviço postgres do Compose)
POSTGRES_DB=controle_rotina
POSTGRES_USER=controle
POSTGRES_PASSWORD=controle

# JDBC visto de dentro da rede do Compose (hostname "postgres").
# Backend no host (mvn spring-boot:run): troque "postgres" por "localhost".
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/controle_rotina
SPRING_DATASOURCE_USERNAME=controle
SPRING_DATASOURCE_PASSWORD=controle

# HS256: mínimo 32 bytes. Obrigatório quando SPRING_PROFILES_ACTIVE não é local/dev.
APP_SECURITY_JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-bytes
